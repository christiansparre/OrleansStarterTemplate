<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Aspire 17.x is only available from the Aspire daily feed (the "dotnet9" name is historical).
    Remove this file, and "channel": "daily" in aspire.config.json, once Aspire 17.x is released on nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="aspire-daily" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="aspire-daily">
      <package pattern="Aspire*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
